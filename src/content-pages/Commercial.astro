---
import CommercialCta from '../components/sections/CommercialCta.astro';
import CommercialHero from '../components/sections/CommercialHero.astro';
import CommercialPricing from '../components/sections/CommercialPricing.astro';
import CommercialSectors from '../components/sections/CommercialSectors.astro';
import CommercialWhy from '../components/sections/CommercialWhy.astro';
import Flourish from '../components/Flourish.astro';
import PageLayout from '../layouts/PageLayout.astro';
import type { Locale } from '../i18n/config';
import type { RouteId } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

/*
 * The business landing page. Not a variant of the Services page: different
 * audience, different sectors, and a quote that is calculated rather than
 * listed. Five sections, all built from the existing library.
 *
 * On the 1160px grid, matching the residential page it sits beside in the nav.
 */
interface Props {
	locale: Locale;
	route: RouteId;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
---

<PageLayout
	locale={locale}
	route={route}
	title={`${t('meta.commercial.title')} | ${t('site.name')}`}
	description={t('meta.commercial.description')}
	pageClass="ms-main--services"
>
	<Flourish name="services-cluster" slot="flourish" />

	<CommercialHero locale={locale} />
	<CommercialSectors locale={locale} />
	<CommercialWhy locale={locale} />
	<CommercialPricing locale={locale} />
	<CommercialCta locale={locale} />
</PageLayout>
