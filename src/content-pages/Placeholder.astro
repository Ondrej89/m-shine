---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import PageLayout from '../layouts/PageLayout.astro';
import type { Locale } from '../i18n/config';
import type { RouteId } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

/*
 * A stub for routes that are registered but not yet built.
 *
 * It exists so the header nav and the language switcher have somewhere real to
 * point during review — every link resolves, in all three languages. Each of
 * these is replaced by its own component in step 3; when the last one goes,
 * this file goes with it.
 */
interface Props {
	locale: Locale;
	route: RouteId;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
---

<PageLayout
	locale={locale}
	route={route}
	title={`${t(`nav.${route}` as 'nav.home')} — ${t('meta.placeholder.title')} | ${t('site.name')}`}
	description={t('meta.placeholder.description')}
>
	<Section>
		<SectionHead eyebrow={t(`nav.${route}` as 'nav.home')} title={t('placeholder.title')} />
		<p style="max-width:60ch;margin-inline:auto;text-align:center;color:var(--ms-color-ink-soft)">
			{t('placeholder.body')}
		</p>
	</Section>
</PageLayout>
