---
/*
 * Still a placeholder — the real home page (hero, services grid, before/after
 * slider, reviews) is built in step 3. What is real here is the chrome: the
 * header, the footer, the page flourish and the design-system primitives, all
 * driven from the locale files.
 */
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Flourish from '../components/Flourish.astro';
import Section from '../components/Section.astro';
import Underline from '../components/Underline.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { localizedPath, type RouteId } from '../i18n/routes';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
	locale: Locale;
	route: RouteId;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
---

<PageLayout
	locale={locale}
	route={route}
	title={`${t('meta.home.title')} | ${t('site.name')}`}
	description={t('meta.home.description')}
	pageClass="ms-main--home"
>
	<Flourish name="home-strip" slot="flourish" />

	<Section class="ms-hero">
		<Eyebrow>{t('home.eyebrow')}</Eyebrow>
		<h1>{t('home.title')}</h1>
		<Underline />
		<p class="ms-hero__lede">{t('home.lede')}</p>
		<div class="ms-hero__actions">
			<Button variant="primary" href={localizedPath(locale, 'quote')} icon="arrow-right">
				{t('home.ctaPrimary')}
			</Button>
			<Button variant="ghost" href={localizedPath(locale, 'services')}>
				{t('home.ctaSecondary')}
			</Button>
		</div>
	</Section>
</PageLayout>

<style>
	.ms-hero h1 {
		margin-block: 14px 12px;
		max-width: 18ch;
	}

	.ms-hero__lede {
		color: var(--ms-color-ink-soft);
		font-size: var(--ms-size-lg);
		margin-top: 20px;
		max-width: 52ch;
	}

	.ms-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: var(--ms-space-5);
	}
</style>
