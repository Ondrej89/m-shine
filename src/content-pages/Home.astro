---
import Flourish from '../components/Flourish.astro';
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import ReviewsCarousel from '../components/sections/ReviewsCarousel.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import SubscriptionCta from '../components/sections/SubscriptionCta.astro';
import WhyChoose from '../components/sections/WhyChoose.astro';
import PageLayout from '../layouts/PageLayout.astro';
import type { Locale } from '../i18n/config';
import type { RouteId } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

/*
 * The home page. Six sections, in the design's order, each one a component.
 *
 * The floral strip is a page-level flourish rather than a section one: the
 * design anchors it to the top of the *document* so it starts behind the
 * header, which is why it hangs off `<main>` and offsets itself upward by
 * `--ms-header-h`.
 */
interface Props {
	locale: Locale;
	route: RouteId;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
---

<PageLayout
	locale={locale}
	route={route}
	title={`${t('meta.home.title')} | ${t('site.name')}`}
	description={t('meta.home.description')}
	pageClass="ms-main--home"
>
	<Flourish name="home-strip" slot="flourish" />

	<HomeHero locale={locale} />
	<ServicesGrid locale={locale} />
	<WhyChoose locale={locale} />
	<BeforeAfter locale={locale} />
	<SubscriptionCta locale={locale} />
	<ReviewsCarousel locale={locale} />
</PageLayout>
