---
/*
 * The site's single route.
 *
 * Every page exists once, as a component in `src/content-pages/`, and is
 * rendered here for all three languages. `allRoutePaths()` expands the route
 * registry into one static path per (page x language) pair, so adding a page
 * means adding an entry to `src/i18n/routes.ts` and a component to the map
 * below — never writing the same page three times.
 *
 * German is the default locale and is not prefixed, so its `path` param is
 * `undefined` and Astro emits `/`. English and Slovak get `/en/…` and `/sk/…`.
 */
import type { Locale } from '../i18n/config';
import { allRoutePaths, type RouteId } from '../i18n/routes';
import About from '../content-pages/About.astro';
import Commercial from '../content-pages/Commercial.astro';
import Contact from '../content-pages/Contact.astro';
import Home from '../content-pages/Home.astro';
import Pricing from '../content-pages/Pricing.astro';
import Quote from '../content-pages/Quote.astro';
import ServiceDetail from '../content-pages/ServiceDetail.astro';
import Services from '../content-pages/Services.astro';
import Styleguide from '../content-pages/Styleguide.astro';

export function getStaticPaths() {
	return allRoutePaths();
}

/*
 * Every route now has a real page — `Placeholder.astro` is gone with the last
 * one it stood in for.
 *
 * The four service routes share one component: `ServiceDetail` reads the route
 * back into a catalogue entry, so the template is written once.
 */
const PAGES = {
	home: Home,
	styleguide: Styleguide,
	about: About,
	services: Services,
	commercial: Commercial,
	serviceHouse: ServiceDetail,
	serviceApartment: ServiceDetail,
	serviceMove: ServiceDetail,
	serviceDeep: ServiceDetail,
	pricing: Pricing,
	contact: Contact,
	quote: Quote,
} satisfies Record<RouteId, unknown>;

interface Props {
	locale: Locale;
	route: RouteId;
}

const { locale, route } = Astro.props;
const Page = PAGES[route] as (typeof PAGES)[RouteId];
---

<Page locale={locale} route={route} />
