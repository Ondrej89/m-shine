---
/*
 * The site's single route.
 *
 * Every page exists once, as a component in `src/content-pages/`, and is
 * rendered here for all three languages. `allRoutePaths()` expands the route
 * registry into one static path per (page x language) pair, so adding a page
 * means adding an entry to `src/i18n/routes.ts` and a component to the map
 * below — never writing the same page three times.
 *
 * German is the default locale and is not prefixed, so its `path` param is
 * `undefined` and Astro emits `/`. English and Slovak get `/en/…` and `/sk/…`.
 */
import type { Locale } from '../i18n/config';
import { allRoutePaths, type RouteId } from '../i18n/routes';
import About from '../content-pages/About.astro';
import Home from '../content-pages/Home.astro';
import Placeholder from '../content-pages/Placeholder.astro';
import Styleguide from '../content-pages/Styleguide.astro';

export function getStaticPaths() {
	return allRoutePaths();
}

/*
 * `Placeholder` is a stub, not a page: it exists so every nav link and every
 * language-switcher target resolves during review. It is replaced one page at
 * a time; four are left.
 */
const PAGES = {
	home: Home,
	styleguide: Styleguide,
	about: About,
	services: Placeholder,
	pricing: Placeholder,
	contact: Placeholder,
	quote: Placeholder,
} satisfies Record<RouteId, unknown>;

interface Props {
	locale: Locale;
	route: RouteId;
}

const { locale, route } = Astro.props;
const Page = PAGES[route] as (typeof PAGES)[RouteId];
---

<Page locale={locale} route={route} />
