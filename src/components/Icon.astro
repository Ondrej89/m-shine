---
/*
 * The design's icon set, inlined.
 *
 * Every icon in the reference is a hand-written 24x24 Feather-style stroke SVG
 * pasted into the markup. Collecting them here means one definition each, and
 * `currentColor` throughout so a chip or a button controls its own colour.
 *
 * The socials and the brand marks are filled rather than stroked — they come
 * from the footer design and are kept exactly as drawn.
 */
export type IconName =
	| 'arrow-right'
	| 'calendar'
	| 'check'
	| 'check-circle'
	| 'chevron-down'
	| 'phone'
	| 'mail'
	| 'pin'
	| 'clock'
	| 'shield'
	| 'sparkle'
	| 'target'
	| 'eye'
	| 'leaf'
	| 'star'
	| 'send'
	| 'menu'
	| 'shield-check'
	| 'user-check'
	| 'clipboard-check'
	| 'calendar-check'
	| 'repeat'
	| 'tag'
	| 'house'
	| 'chevron-left'
	| 'chevron-right'
	| 'facebook'
	| 'instagram'
	| 'google';

interface Props {
	name: IconName;
	size?: number;
	class?: string;
	/** Stroke width for the outline icons; ignored by the filled ones. */
	stroke?: number;
	/** Overrides how the icon is painted. The star is filled by default because
	 *  every rating row uses it that way; the About principles draw the same
	 *  shape as an outline, which is what this is for. */
	filled?: boolean;
}

const { name, size = 18, class: className, stroke = 2, filled: filledProp } = Astro.props;

const FILLED = new Set<IconName>(['facebook', 'google', 'star']);
const filled = filledProp ?? FILLED.has(name);

const paths: Record<IconName, string> = {
	'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
	calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
	check: '<path d="M20 6L9 17l-5-5"/>',
	'check-circle': '<circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/>',
	'chevron-down': '<path d="M6 9l6 6 6-6"/>',
	phone:
		'<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
	mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>',
	pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
	sparkle:
		'<path d="M12 3l1.9 4.1L18 9l-4.1 1.9L12 15l-1.9-4.1L6 9l4.1-1.9z"/><path d="M18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9z"/>',
	leaf: '<path d="M4 20c8 2 16-4 16-14 0 0-12-2-14 6-1 4 0 6-2 8z"/><path d="M9 15c2-3 5-5 8-6"/>',
	target: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
	eye: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>',
	star: '<path d="M12 2l3.1 6.3 7 1-5 4.9 1.2 6.9L12 17.8 5.7 21.1 6.9 14.2l-5-4.9 7-1z"/>',
	send: '<path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>',
	menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
	'shield-check': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
	'user-check':
		'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 11l-3 3-1.5-1.5"/>',
	'clipboard-check':
		'<path d="M9 2h6a1 1 0 0 1 1 1v2H8V3a1 1 0 0 1 1-1z"/><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><path d="M9 14l2 2 4-4"/>',
	'calendar-check':
		'<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M9 16l2 2 4-4"/>',
	repeat:
		'<path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>',
	tag: '<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><path d="M7 7h.01"/>',
	house: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>',
	'chevron-left': '<path d="M15 18l-6-6 6-6"/>',
	'chevron-right': '<path d="M9 18l6-6-6-6"/>',
	facebook:
		'<path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/>',
	instagram:
		'<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>',
	google:
		'<path d="M21.35 11.1h-9.17v2.98h5.27c-.23 1.4-1.66 4.1-5.27 4.1-3.17 0-5.76-2.62-5.76-5.85s2.59-5.85 5.76-5.85c1.8 0 3.01.77 3.7 1.43l2.52-2.43C16.9 3.96 14.76 3 12.18 3 6.98 3 2.76 7.2 2.76 12.4s4.22 9.4 9.42 9.4c5.44 0 9.04-3.82 9.04-9.2 0-.62-.07-1.09-.16-1.5z"/>',
};
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill={filled ? 'currentColor' : 'none'}
	stroke={filled ? undefined : 'currentColor'}
	stroke-width={filled ? undefined : stroke}
	stroke-linecap={filled ? undefined : 'round'}
	stroke-linejoin={filled ? undefined : 'round'}
	aria-hidden="true"
	focusable="false"
	set:html={paths[name]}
/>
