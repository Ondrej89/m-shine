---
/*
 * The inline "Learn More" link with an arrow that nudges right on hover. The
 * arrow is a CSS mask on a pseudo-element (buttons.css) so the label stays
 * plain text and the arrow inherits the link colour.
 */
interface Props {
	href: string;
	class?: string;
	[key: string]: unknown;
}

const { href, class: className, ...rest } = Astro.props;
const classes = ['ms-learn', className].filter(Boolean).join(' ');
---

<a class={classes} href={href} {...rest}><slot /></a>
