---
import Flag from './Flag.astro';
import Icon from './Icon.astro';
import { LOCALE_META, LOCALES, type Locale } from '../i18n/config';
import { localizedPath, type RouteId } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

/*
 * The design's flag dropdown, rebuilt on links.
 *
 * The reference switcher is a set of <button>s that mutate client state. Ours
 * cannot be: the three languages are three real URLs and a crawler has to be
 * able to follow them, so every option is an <a> and the current one carries
 * `aria-current` instead of an `.is-current` class. Visually identical — see
 * the note at the top of the language-switcher block in header.css.
 *
 * It links to the SAME page in the other language, never to that language's
 * home page, and it keeps working once slugs diverge (`/leistungen/` vs
 * `/services/`) because `localizedPath` resolves per route id.
 */
interface Props {
	locale: Locale;
	route: RouteId;
	class?: string;
}

const { locale, route, class: className } = Astro.props;
const t = useTranslations(locale);
const current = LOCALE_META[locale];

const options = LOCALES.map((code) => ({
	...LOCALE_META[code],
	href: localizedPath(code, route),
	isCurrent: code === locale,
}));

const classes = ['ms-lang', className].filter(Boolean).join(' ');
---

<div class={classes} data-ms-lang>
	<button
		class="ms-lang__toggle"
		type="button"
		aria-expanded="false"
		aria-haspopup="true"
		aria-label={t('a11y.languageLabel')}
	>
		<Flag locale={locale} />
		<span>{current.short}</span>
		<Icon name="chevron-down" size={11} stroke={2.4} class="ms-chevron" />
	</button>

	<ul class="ms-lang__menu" aria-label={t('a11y.languageLabel')}>
		{
			options.map((option) => (
				<li>
					<a
						class="ms-lang__item"
						href={option.href}
						hreflang={option.lang}
						lang={option.lang}
						aria-current={option.isCurrent ? 'true' : undefined}
						aria-label={option.label}
					>
						<Flag locale={option.code} />
						{/* The visible label is hidden by CSS below 900px, where the menu
						    becomes a row of flags — hence the aria-label above, so the
						    link keeps an accessible name at every width. */}
						<span class="ms-lang__label">{option.label}</span>
						{option.isCurrent && <Icon name="check" size={15} stroke={2.6} class="ms-lang__check" />}
					</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	/*
	 * Opens the dropdown. Deliberately tiny and inline-scoped: the switcher is
	 * three links that already work without it — the script only collapses them
	 * behind a toggle on wide screens. Below 900px the menu is always a visible
	 * row and the toggle is hidden, so none of this runs meaningfully there.
	 */
	document.querySelectorAll<HTMLElement>('[data-ms-lang]').forEach((root) => {
		const toggle = root.querySelector<HTMLButtonElement>('.ms-lang__toggle');
		if (!toggle) return;

		const setOpen = (open: boolean) => {
			root.classList.toggle('is-open', open);
			toggle.setAttribute('aria-expanded', String(open));
		};

		toggle.addEventListener('click', (event) => {
			event.stopPropagation();
			setOpen(!root.classList.contains('is-open'));
		});

		// Clicking anywhere else, or pressing Escape, closes it. Escape also
		// returns focus to the toggle so keyboard users are not dropped at the
		// top of the document.
		document.addEventListener('click', (event) => {
			if (!root.contains(event.target as Node)) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !root.classList.contains('is-open')) return;
			setOpen(false);
			toggle.focus();
		});
	});
</script>
