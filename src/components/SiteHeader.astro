---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SITE_DETAILS } from '../data/site';
import type { Locale } from '../i18n/config';
import { NAV_ROUTES, localizedPath, type RouteId } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { withBase } from '../lib/paths';

/*
 * The site header: brand, navigation, phone, quote CTA and the language
 * switcher, collapsing to a burger panel at 1000px.
 *
 * `.ms-header__panel` is `display: contents` on desktop, so the nav and the
 * actions are direct flex children of the header; below 1000px it becomes the
 * slide-down panel. That is what lets the links exist exactly ONCE in the
 * document — the reference design duplicates its whole nav into a second
 * mobile block, which would mean two copies of every link for a crawler to
 * find and two places to keep in step.
 *
 * The design's "Book Your Cleaning" button is the quote CTA now; the booking
 * engine is gone.
 */
interface Props {
	locale: Locale;
	/** The current page, so its nav item can be marked and the switcher can
	 *  link to the same page in the other languages. */
	route: RouteId;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);

const navItems = NAV_ROUTES.map((id) => ({
	id,
	href: localizedPath(locale, id),
	label: t(`nav.${id}` as 'nav.home'),
	isCurrent: id === route,
}));
---

<div class="ms-header-wrap" data-ms-header>
	<header class="ms-header">
		<a class="ms-brand" href={localizedPath(locale, 'home')}>
			<img
				class="ms-brand__mark"
				src={withBase('/img/logo-mark.webp')}
				alt=""
				width="77"
				height="38"
				decoding="async"
			/>
			<span class="ms-brand__name">{t('site.name')}</span>
		</a>

		<button class="ms-burger" type="button" aria-expanded="false" aria-controls="ms-menu">
			<Icon name="menu" size={22} stroke={2.2} />
			<span class="screen-reader-text">{t('a11y.menu')}</span>
		</button>

		<div class="ms-header__panel" id="ms-menu">
			<nav class="ms-header__nav" aria-label={t('a11y.mainNav')}>
				<ul>
					{
						navItems.map((item) => (
							<li>
								<a href={item.href} aria-current={item.isCurrent ? 'page' : undefined}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="ms-header__actions">
				<a class="ms-phone" href={`tel:${SITE_DETAILS.phoneHref}`}>
					<span class="ms-icon ms-icon--blue"><Icon name="phone" size={17} /></span>
					<span>
						<span class="ms-phone__number">{SITE_DETAILS.phone}</span>
						<span class="ms-phone__note">{t('header.phoneNote')}</span>
					</span>
				</a>

				{/*
				 * No trailing icon. The design put a calendar here because it was a
				 * booking button; requesting a quote is not a calendar action, and
				 * dropping it also buys back 25px in a row that had none to spare.
				 */}
				<a class="ms-btn ms-btn--primary ms-bookbtn" href={localizedPath(locale, 'quote')}>
					{t('nav.quote')}
				</a>

				<LanguageSwitcher locale={locale} route={route} />
			</div>
		</div>
	</header>
</div>

<script>
	/*
	 * Burger toggle. The panel is a plain block below 1000px whose `max-height`
	 * animates from 0, so opening it is one class on the wrapper — see
	 * header.css. Nothing here runs above 1000px, where the panel is
	 * `display: contents` and the burger is hidden.
	 */
	document.querySelectorAll<HTMLElement>('[data-ms-header]').forEach((wrap) => {
		const burger = wrap.querySelector<HTMLButtonElement>('.ms-burger');
		if (!burger) return;

		const setOpen = (open: boolean) => {
			wrap.classList.toggle('is-open', open);
			burger.setAttribute('aria-expanded', String(open));
		};

		burger.addEventListener('click', () => setOpen(!wrap.classList.contains('is-open')));

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !wrap.classList.contains('is-open')) return;
			setOpen(false);
			burger.focus();
		});

		// Leaving the mobile range with the panel still open would strand the
		// `is-open` class on a header that no longer uses it.
		const wide = window.matchMedia('(min-width: 901px)');
		wide.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	});
</script>
