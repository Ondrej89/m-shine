---
import Button from '../Button.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import ServiceCard from '../ServiceCard.astro';
import { SERVICES, type Service } from '../../data/services';
import type { Locale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

/*
 * The four-card services grid.
 *
 * The list comes from the catalogue in `src/data/services.ts`, which is also
 * what the Services page's rows and the detail template read, so a service is
 * described in exactly one place. It stays a prop so a page can show a subset.
 */
interface Props {
	locale: Locale;
	/** Which services to show, in order. Defaults to the whole catalogue. */
	services?: readonly Service[];
	showCta?: boolean;
}

const { locale, services = SERVICES, showCta = true } = Astro.props;
const t = useTranslations(locale);
---

<Section class="ms-services" rhythm="none" clip>
	<SectionHead eyebrow={t('services.eyebrow')} title={t('services.title')} />

	<div class="ms-services__grid">
		{
			services.map((service) => (
				<ServiceCard
					title={t(`services.${service.key}.title` as 'services.house.title')}
					description={t(`services.${service.key}.description` as 'services.house.description')}
					imageAlt={t(`services.${service.key}.photoAlt` as 'services.house.photoAlt')}
					image={service.cardImage}
					icon={service.key}
					href={localizedPath(locale, service.route)}
					linkLabel={t('services.learnMore')}
				/>
			))
		}
	</div>

	{
		showCta && (
			<div class="ms-services__cta">
				<Button variant="primary" href={localizedPath(locale, 'services')} icon="arrow-right">
					{t('services.viewAll')}
				</Button>
			</div>
		)
	}
</Section>
