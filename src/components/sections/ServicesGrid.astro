---
import Button from '../Button.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import ServiceCard from '../ServiceCard.astro';
import type { Locale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

/*
 * The four-card services grid on the home page — commercial cleaning.
 *
 * The cards are the first four sectors of the Commercial page, and they read
 * that page's copy: `commercial.sectors.<n>.title` for the name and its
 * `cardShort` / `cardPhotoAlt` for the one-line version, so a sector is named
 * and described in exactly one place. The keys are the sector keys for that
 * reason — `one`..`four` is the Commercial page's own order, and the two lists
 * must stay in it. The fifth sector (Hausverwaltung) has no card: the design
 * draws four and the grid's tracks are `repeat(4, 1fr)`.
 *
 * Each card asks for a quote rather than linking on to a detail page — there
 * are detail pages for the private-customer services only. The button under the
 * grid still goes to the residential Services page: the home page keeps one
 * route through to the private-customer side, which is deliberate.
 */
interface Props {
	locale: Locale;
	showCta?: boolean;
}

const { locale, showCta = true } = Astro.props;
const t = useTranslations(locale);

const CARDS = [
	{ key: 'one', icon: 'office', image: '/img/photos/home-svc-office.webp' },
	{ key: 'two', icon: 'practice', image: '/img/photos/home-svc-practice.webp' },
	{ key: 'three', icon: 'hotel', image: '/img/photos/home-svc-hotel.webp' },
	{ key: 'four', icon: 'restaurant', image: '/img/photos/home-svc-restaurant.webp' },
] as const;
---

<Section class="ms-services" rhythm="none" clip>
	<SectionHead eyebrow={t('services.eyebrow')} title={t('services.title')} />

	<div class="ms-services__grid">
		{
			CARDS.map((card) => (
				<ServiceCard
					title={t(`commercial.sectors.${card.key}.title` as 'commercial.sectors.one.title')}
					description={t(
						`commercial.sectors.${card.key}.cardShort` as 'commercial.sectors.one.cardShort',
					)}
					imageAlt={t(
						`commercial.sectors.${card.key}.cardPhotoAlt` as 'commercial.sectors.one.cardPhotoAlt',
					)}
					image={card.image}
					icon={card.icon}
					href={localizedPath(locale, 'quote')}
					linkLabel={t('cta.request')}
				/>
			))
		}
	</div>

	{
		showCta && (
			<div class="ms-services__cta">
				<Button variant="primary" href={localizedPath(locale, 'services')} icon="arrow-right">
					{t('services.viewAll')}
				</Button>
			</div>
		)
	}
</Section>
