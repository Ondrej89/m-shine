---
import Button from '../Button.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import ServiceCard, { type ServiceIcon } from '../ServiceCard.astro';
import type { Locale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

/*
 * The four-card services grid. Written to be reusable — the Services page
 * needs the same cards with a fifth entry — so the list of services is a prop
 * rather than baked in.
 */
interface Props {
	locale: Locale;
	/** Which services to show, in order. Keys index into `services.*` copy. */
	services?: readonly { key: string; icon: ServiceIcon; image: string }[];
	showCta?: boolean;
}

const HOME_SERVICES = [
	{ key: 'house', icon: 'house', image: '/img/photos/home-svc-house.webp' },
	{ key: 'apartment', icon: 'apartment', image: '/img/photos/home-svc-apt.webp' },
	{ key: 'move', icon: 'move', image: '/img/photos/home-svc-move.webp' },
	{ key: 'deep', icon: 'deep', image: '/img/photos/home-svc-deep.webp' },
] as const satisfies readonly { key: string; icon: ServiceIcon; image: string }[];

const { locale, services = HOME_SERVICES, showCta = true } = Astro.props;
const t = useTranslations(locale);
---

<Section class="ms-services" rhythm="none" clip>
	<SectionHead eyebrow={t('services.eyebrow')} title={t('services.title')} />

	<div class="ms-services__grid">
		{
			services.map((service) => (
				<ServiceCard
					title={t(`services.${service.key}.title` as 'services.house.title')}
					description={t(`services.${service.key}.description` as 'services.house.description')}
					imageAlt={t(`services.${service.key}.photoAlt` as 'services.house.photoAlt')}
					image={service.image}
					icon={service.icon}
					href={localizedPath(locale, 'services')}
					linkLabel={t('services.learnMore')}
				/>
			))
		}
	</div>

	{
		showCta && (
			<div class="ms-services__cta">
				<Button variant="primary" href={localizedPath(locale, 'services')} icon="arrow-right">
					{t('services.viewAll')}
				</Button>
			</div>
		)
	}
</Section>
