---
import Eyebrow from '../Eyebrow.astro';
import Section from '../Section.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { withBase } from '../../lib/paths';

/*
 * "Our Story" — photo left, copy right.
 *
 * The design hard-breaks the heading after "Built on Trust,". That break is
 * dropped for the same reason the home hero drops its own: it lands in the
 * wrong place in two of the three languages. The line wraps inside the column
 * instead.
 *
 * It used to close on three figures — "10.000+ gereinigte Zuhause", "4,9
 * Durchschnittsbewertung", "98 % Stammkundschaft" — read straight from
 * `home.stats.*`. Those were the design's invented numbers and the client had
 * them removed (2026-08-28). Because both pages read one set of strings, they
 * went from both at once, which is exactly what sharing them was for. They are
 * NOT replaced: no substitute figure has been substantiated either, and the
 * story reads perfectly well as two paragraphs.
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section class="ms-about-story" rhythm="none">
	<div class="ms-about-story__grid">
		<figure class="ms-about-story__figure">
			<img
				src={withBase('/img/photos/about-story.webp')}
				alt={t('about.story.photoAlt')}
				width="1200"
				height="675"
				loading="lazy"
				decoding="async"
			/>
		</figure>

		<div class="ms-about-story__copy">
			<Eyebrow>{t('about.story.eyebrow')}</Eyebrow>
			<h2 class="ms-about-story__title">{t('about.story.title')}</h2>
			<p>{t('about.story.bodyOne')}</p>
			<p>{t('about.story.bodyTwo')}</p>
		</div>
	</div>
</Section>
