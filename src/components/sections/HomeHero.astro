---
import Button from '../Button.astro';
import Eyebrow from '../Eyebrow.astro';
import Icon, { type IconName } from '../Icon.astro';
import Section from '../Section.astro';
import type { Locale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { withBase } from '../../lib/paths';

/*
 * The home hero: copy and trust row on the left, photo with a floating stats
 * card on the right.
 *
 * Two things about it are unusual and deliberate, both from the refined theme:
 * the media column is a fixed 750px so the photo bleeds ~61px past the
 * container toward the viewport edge, and the section does NOT clip, because
 * clipping sliced the right side off the stats card.
 *
 * The design hard-breaks the h1 after "Luxury Cleaning". That break is dropped
 * here: German runs roughly a third longer than English and a hard <br> lands
 * in the wrong place in two of the three languages. The line wraps naturally
 * inside the grid column instead.
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* Three, not the design's four: the insured/bonded claim came out because the
   client cannot substantiate it. The tones still alternate blue/green/blue. */
const TRUST = [
	{ key: 'guarantee', icon: 'shield-check', tone: 'blue' },
	{ key: 'eco', icon: 'leaf', tone: 'green' },
	{ key: 'checked', icon: 'user-check', tone: 'blue' },
] as const;

/*
 * The floating card the hero photo carries. It used to hold four statistics;
 * three of them — "10.000+ gereinigte Zuhause", "4,9 Durchschnittsbewertung",
 * "98 % Stammkundschaft" — were the design's invented numbers and came out at
 * the client's instruction (2026-08-28), the same call that removed
 * "Insured & Bonded". They are NOT replaced with different numbers.
 *
 * What is left would have been one lonely row on a card sized for four, so the
 * two facts the client did confirm take the other slots: where we work and
 * when we answer. Both are real, both are useful above the fold, and the
 * service area had nowhere else to live on the home page. The card keeps its
 * `.ms-stat` classes — the value/label pair is the same shape — and every
 * value is short on purpose, because the 19px bold line sets the card's width
 * and the card's width comes off the photo.
 */
const FACTS = [
	{ key: 'area', icon: 'pin' },
	{ key: 'hours', icon: 'clock' },
	{ key: 'satisfaction', icon: 'shield-check' },
] as const;
---

<Section class="ms-hero" rhythm="none">
	<div class="ms-hero__grid">
		<div class="ms-hero__intro">
			<Eyebrow pill>{t('home.hero.eyebrow')}</Eyebrow>

			<h1 class="ms-hero__title">
				{t('home.hero.titleLead')}{' '}
				<span class="ms-accent">{t('home.hero.titleAccent')}</span>
			</h1>

			<p class="ms-hero__lede">{t('home.hero.lede')}</p>

			<div class="ms-hero__actions">
				<Button variant="primary" href={localizedPath(locale, 'quote')} icon="arrow-right">
					{t('home.hero.ctaPrimary')}
				</Button>
				<Button variant="ghost" href={localizedPath(locale, 'services')} icon="arrow-right">
					{t('home.hero.ctaSecondary')}
				</Button>
			</div>

			<ul class="ms-trust">
				{
					TRUST.map((item) => (
						<li class="ms-trust__item">
							<span class={`ms-icon ms-icon--${item.tone}`}>
								<Icon name={item.icon as IconName} size={16} />
							</span>
							<span>{t(`home.trust.${item.key}` as 'home.trust.eco')}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div class="ms-hero__media">
			<figure class="ms-hero__figure ms-mask-fade ms-mask-fade--deep">
				{/*
				 * The only image above the fold, and the page's LCP element — hence
				 * `eager` and `fetchpriority`, while everything below stays lazy.
				 */}
				<img
					src={withBase('/img/photos/home-hero.webp')}
					alt={t('home.hero.photoAlt')}
					width="750"
					height="500"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</figure>

			<ul class="ms-hero__stats">
				{
					FACTS.map((fact) => (
						<li class="ms-stat">
							<span class="ms-stat__icon">
								<Icon name={fact.icon as IconName} size={19} />
							</span>
							<span>
								<b class="ms-stat__value">
									{t(`home.facts.${fact.key}.value` as 'home.facts.area.value')}
								</b>
								<span class="ms-stat__label">
									{t(`home.facts.${fact.key}.label` as 'home.facts.area.label')}
								</span>
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</Section>
