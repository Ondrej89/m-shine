---
import Button from '../Button.astro';
import Icon, { type IconName } from '../Icon.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import type { Locale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

/*
 * The seven sectors, each with a paragraph and three specifics.
 *
 * The cards are the old commercial strip's — same icons, same tinted chips —
 * but carrying real copy instead of a bare label, so they are three across and
 * left-aligned. The bullets reuse the Services rows' tick list.
 *
 * Stiegenhausreinigung and Fensterreinigung (six and seven) were added on the
 * client's instruction, 2026-08-28: she already sells both and neither was on
 * the site. They go at the end because the first five are ordered by how much
 * of the business they are, and because the home page's card grid reads
 * `one`..`four` — the keys are positional there, so appending is the only safe
 * place to add. Seven cards fill the three-across grid as 3 + 3 + 1; five
 * already left a ragged 3 + 2, so nothing about the layout is new.
 *
 * The last two are also the only two that are a *task* rather than a customer
 * type. That is deliberate and the client's framing: a property manager books
 * a stairwell, a restaurant books its windows, and both want to see the words.
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* Tones alternate blue/green down the list, so a card's tone is its position,
   not its subject. `stairs` and `window` were drawn for these two — see
   Icon.astro; the nearest existing glyphs were a graduation cap and an eye. */
const SECTORS = [
	{ key: 'one', icon: 'office', tone: 'blue' },
	{ key: 'two', icon: 'clinic', tone: 'green' },
	{ key: 'three', icon: 'bed', tone: 'blue' },
	{ key: 'four', icon: 'restaurant', tone: 'green' },
	{ key: 'five', icon: 'apartments', tone: 'blue' },
	{ key: 'six', icon: 'stairs', tone: 'green' },
	{ key: 'seven', icon: 'window', tone: 'blue' },
] as const;

const POINTS = ['one', 'two', 'three'] as const;
---

<Section class="ms-b2b-sectors" width={1160} rhythm="none" band>
	<SectionHead
		eyebrow={t('commercial.sectorsEyebrow')}
		title={t('commercial.sectorsTitle')}
		divider={false}
	>
		<p class="ms-b2b-sectors__lede">{t('commercial.sectorsLede')}</p>
	</SectionHead>

	<ul class="ms-comm-grid">
		{
			SECTORS.map((sector) => (
				<li class="ms-comm-card">
					<span class={`ms-comm-card__icon ms-comm-card__icon--${sector.tone}`}>
						<Icon name={sector.icon as IconName} size={24} stroke={1.8} />
					</span>

					<h3 class="ms-comm-card__label">
						{t(`commercial.sectors.${sector.key}.title` as 'commercial.sectors.one.title')}
					</h3>
					<p class="ms-comm-card__body">
						{t(`commercial.sectors.${sector.key}.body` as 'commercial.sectors.one.body')}
					</p>

					<ul class="ms-svc-feats">
						{POINTS.map((point) => (
							<li class="ms-svc-feat">
								<Icon class="ms-svc-feat__tick" name="check" size={15} stroke={2.4} />
								<span>
									{t(
										`commercial.sectors.${sector.key}.points.${point}` as 'commercial.sectors.one.points.one',
									)}
								</span>
							</li>
						))}
					</ul>
				</li>
			))
		}
	</ul>

	<div class="ms-b2b-actions">
		<Button variant="primary" href={localizedPath(locale, 'quote')} icon="arrow-right">
			{t('cta.request')}
		</Button>
	</div>
</Section>
