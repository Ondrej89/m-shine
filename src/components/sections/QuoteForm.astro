---
import Eyebrow from '../Eyebrow.astro';
import Icon from '../Icon.astro';
import Section from '../Section.astro';
import { SITE_DETAILS } from '../../data/site';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

/*
 * The quote request wizard — the booking wizard's four steps, one at a time.
 *
 * The markup renders every step expanded and the Next/Back controls hidden.
 * The script then takes over: it hides all but the current step and reveals
 * the controls. That order matters — with no JavaScript the page stays a
 * single long form that submits correctly, which is what it degrades to rather
 * than a wizard stuck on step one with no way forward.
 *
 * Values survive stepping because nothing is ever removed: the whole form is
 * one `<form>` and stepping only toggles `hidden`. There is no serialisation
 * and nothing to restore.
 *
 * The private/business branch is handled by disabling the inactive half's
 * `<fieldset>`, which both removes its fields from submission and stops them
 * being validated. Switching branches also resets those fields, so a business
 * enquiry can never arrive carrying a half-filled private one. The `:has()`
 * rule in quote.css does the same hiding for the no-JavaScript case.
 *
 * The form posts to Web3Forms — see the long note in `src/data/site.ts`, and
 * ContactSection.astro, which does the same three-state dance for the shorter
 * form. Here the states are:
 *
 *   live + ok      the form is replaced by the success panel.
 *   live + failed  an error appears inside step four, under the action row,
 *                  and the wizard stays exactly as it was. Four steps of
 *                  answers must survive a bad minute at a third-party API.
 *   no key yet     the same panel appears carrying `quote.pendingTitle` /
 *                  `pendingBody`, which say plainly that nothing was sent.
 *
 * The success panel is shared between the sent and the not-connected case, and
 * its text is swapped by the script, because the two differ in wording and in
 * nothing else.
 *
 * Without JavaScript the whole thing is one long form that posts to the same
 * endpoint and lands on Web3Forms' own confirmation page.
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const STEPS = ['step1', 'step2', 'step3', 'step4'] as const;

const CLEANING_TYPES = [
	{ value: 'regular', key: 'fTypeRegular' },
	{ value: 'deep', key: 'fTypeDeep' },
	{ value: 'move', key: 'fTypeMove' },
] as const;

const PREMISES = [
	{ value: 'office', key: 'fPremisesOffice' },
	{ value: 'clinic', key: 'fPremisesClinic' },
	{ value: 'hotel', key: 'fPremisesHotel' },
	{ value: 'restaurant', key: 'fPremisesRestaurant' },
	{ value: 'property', key: 'fPremisesProperty' },
] as const;

const FREQUENCIES = [
	{ value: 'once', key: 'fFreqOnce' },
	{ value: 'weekly', key: 'fFreqWeekly' },
	{ value: 'biweekly', key: 'fFreqBiweekly' },
	{ value: 'monthly', key: 'fFreqMonthly' },
] as const;

const quoteAction = SITE_DETAILS.quoteAction;
/* As on the contact page: the language marker is for the client's inbox, so
   the subject itself is not a translated string. */
const subject = `${SITE_DETAILS.formSubjects.quote} (${locale.toUpperCase()})`;
---

<Section class="ms-quote" width={1200} rhythm="none">
	<Eyebrow>{t('quote.heroEyebrow')}</Eyebrow>
	<h1 class="ms-quote__title">{t('quote.heroTitle')}</h1>
	<p class="ms-quote__lede">{t('quote.heroLede')}</p>

	<ol class="ms-stepper" data-ms-stepper>
		{
			STEPS.map((step, index) => (
				<li class="ms-stepper__item" data-stepper-step={index + 1}>
					<span class="ms-stepper__label">{t(`quote.${step}` as 'quote.step1')}</span>
				</li>
			))
		}
	</ol>

	{/*
	 * Announces the position for screen readers. The stepper shows it visually,
	 * so this is never painted — the design has no counter line.
	 */}
	<p class="screen-reader-text" role="status" data-ms-quote-count></p>
</Section>

<Section class="ms-quote-body" width={1200} rhythm="none">
	<div class="ms-quote__grid">
		<div>
			<form
				class="ms-quote__form"
				action={quoteAction ?? undefined}
				method="post"
				data-ms-quote={quoteAction ? 'live' : 'pending'}
			>
				{/*
				 * Web3Forms' own fields — see ContactSection.astro for what each one
				 * does. They sit outside every `<fieldset data-step>`, which matters:
				 * the branch switch disables whole fieldsets, and these must never be
				 * disabled or the submission would arrive with no access key.
				 */}
				<input type="hidden" name="access_key" value={SITE_DETAILS.formAccessKey ?? ''} />
				<input type="hidden" name="subject" value={subject} />
				<input type="hidden" name="from_name" value={t('site.name')} />
				<input
					type="checkbox"
					name="botcheck"
					style="display:none"
					tabindex="-1"
					autocomplete="off"
					aria-hidden="true"
				/>
				{/* ---- Step 1: who is asking ---- */}
				<fieldset class="ms-qstep" data-step="1">
					<legend class="ms-qstep__head" tabindex="-1">{t('quote.s1Title')}</legend>

					<ul class="ms-qopts">
						<li class="ms-qopt">
							<input
								class="ms-qopt__input"
								type="radio"
								name="customerKind"
								id="ms-q-kind-private"
								value="private"
								checked
							/>
							<label class="ms-qopt__card" for="ms-q-kind-private">
								<span class="ms-qopt__icon"><Icon name="house" size={20} /></span>
								<span>
									<span class="ms-qopt__name">{t('quote.s1Private')}</span>
									<span class="ms-qopt__note">{t('quote.s1PrivateNote')}</span>
								</span>
							</label>
						</li>

						<li class="ms-qopt">
							<input
								class="ms-qopt__input"
								type="radio"
								name="customerKind"
								id="ms-q-kind-business"
								value="business"
							/>
							<label class="ms-qopt__card" for="ms-q-kind-business">
								<span class="ms-qopt__icon"><Icon name="office" size={20} /></span>
								<span>
									<span class="ms-qopt__name">{t('quote.s1Business')}</span>
									<span class="ms-qopt__note">{t('quote.s1BusinessNote')}</span>
								</span>
							</label>
						</li>
					</ul>
				</fieldset>

				{/* ---- Step 2: the property, private ---- */}
				<fieldset class="ms-qstep" data-step="2" data-when="private">
					<legend class="ms-qstep__head" tabindex="-1">{t('quote.s2Title')}</legend>
					<p class="ms-qstep__hint">{t('quote.s2PrivateHint')}</p>

					<div class="ms-qrow ms-qrow--three">
						<label class="ms-qfield">
							<span class="ms-qfield__label">{t('quote.fSize')}</span>
							<input
								class="ms-qinput"
								type="number"
								name="privateSize"
								min="1"
								inputmode="numeric"
								placeholder={t('quote.phSize')}
							/>
						</label>
						<label class="ms-qfield">
							<span class="ms-qfield__label">{t('quote.fRooms')}</span>
							<input
								class="ms-qinput"
								type="number"
								name="privateRooms"
								min="1"
								inputmode="numeric"
								placeholder={t('quote.phRooms')}
							/>
						</label>
						<label class="ms-qfield">
							<span class="ms-qfield__label">{t('quote.fBaths')}</span>
							<input
								class="ms-qinput"
								type="number"
								name="privateBaths"
								min="0"
								inputmode="numeric"
								placeholder={t('quote.phBaths')}
							/>
						</label>
					</div>

					<label class="ms-qfield">
						<span class="ms-qfield__label">{t('quote.fBedrooms')}</span>
						<input
							class="ms-qinput"
							type="number"
							name="privateBedrooms"
							min="0"
							inputmode="numeric"
							placeholder={t('quote.phBedrooms')}
						/>
					</label>

					<div class="ms-qfield">
						<span class="ms-qfield__label">{t('quote.fCleaningType')}</span>
						<ul class="ms-qchips">
							{
								CLEANING_TYPES.map((type, index) => (
									<li>
										<input
											class="ms-qchip__input"
											type="radio"
											name="cleaningType"
											id={`ms-q-type-${type.value}`}
											value={type.value}
											checked={index === 0}
										/>
										<label class="ms-qchip__label" for={`ms-q-type-${type.value}`}>
											{t(`quote.${type.key}` as 'quote.fTypeRegular')}
										</label>
									</li>
								))
							}
						</ul>
					</div>

					<div class="ms-qfield">
						<span class="ms-qfield__label">{t('quote.fPets')}</span>
						<ul class="ms-qchips">
							{
								[
									{ value: 'no', key: 'fPetsNo' },
									{ value: 'yes', key: 'fPetsYes' },
								].map((pet, index) => (
									<li>
										<input
											class="ms-qchip__input"
											type="radio"
											name="pets"
											id={`ms-q-pets-${pet.value}`}
											value={pet.value}
											checked={index === 0}
										/>
										<label class="ms-qchip__label" for={`ms-q-pets-${pet.value}`}>
											{t(`quote.${pet.key}` as 'quote.fPetsNo')}
										</label>
									</li>
								))
							}
						</ul>
					</div>

					<label class="ms-qfield">
						<span class="ms-qfield__label">
							{t('quote.fAccess')} <span class="ms-qfield__optional">({t('quote.optional')})</span>
						</span>
						<textarea
							class="ms-qinput"
							name="access"
							rows="2"
							placeholder={t('quote.fAccessPlaceholder')}></textarea>
					</label>
				</fieldset>

				{/* ---- Step 2: the premises, business ---- */}
				<fieldset class="ms-qstep" data-step="2" data-when="business">
					<legend class="ms-qstep__head" tabindex="-1">{t('quote.s2Title')}</legend>
					<p class="ms-qstep__hint">{t('quote.s2BusinessHint')}</p>

					<label class="ms-qfield">
						<span class="ms-qfield__label">{t('quote.fPremises')}</span>
						<select class="ms-qinput" name="premisesType">
							{
								PREMISES.map((premises) => (
									<option value={premises.value}>
										{t(`quote.${premises.key}` as 'quote.fPremisesOffice')}
									</option>
								))
							}
						</select>
					</label>

					<div class="ms-qrow ms-qrow--three">
						<label class="ms-qfield">
							<span class="ms-qfield__label">{t('quote.fSize')}</span>
							<input
								class="ms-qinput"
								type="number"
								name="businessSize"
								min="1"
								inputmode="numeric"
								placeholder={t('quote.phBizSize')}
							/>
						</label>
						<label class="ms-qfield">
							<span class="ms-qfield__label">{t('quote.fFloors')}</span>
							<input
								class="ms-qinput"
								type="text"
								name="businessFloors"
								placeholder={t('quote.phFloors')}
							/>
						</label>
						<label class="ms-qfield">
							<span class="ms-qfield__label">{t('quote.fPerWeek')}</span>
							<input
								class="ms-qinput"
								type="number"
								name="perWeek"
								min="1"
								max="14"
								inputmode="numeric"
								placeholder={t('quote.phPerWeek')}
							/>
						</label>
					</div>

					<label class="ms-qfield">
						<span class="ms-qfield__label">{t('quote.fHours')}</span>
						<input
							class="ms-qinput"
							type="text"
							name="preferredHours"
							placeholder={t('quote.fHoursPlaceholder')}
						/>
					</label>

					<label class="ms-qfield">
						<span class="ms-qfield__label">
							{t('quote.fSpecial')} <span class="ms-qfield__optional">({t('quote.optional')})</span>
						</span>
						<textarea
							class="ms-qinput"
							name="specialRequirements"
							rows="2"
							placeholder={t('quote.fSpecialPlaceholder')}></textarea>
					</label>
				</fieldset>

				{/* ---- Step 3: how often, from when ---- */}
				<fieldset class="ms-qstep" data-step="3">
					<legend class="ms-qstep__head" tabindex="-1">{t('quote.s3Title')}</legend>

					<div class="ms-qfield">
						<span class="ms-qfield__label">{t('quote.fFrequency')}</span>
						<ul class="ms-qchips">
							{
								FREQUENCIES.map((frequency, index) => (
									<li>
										<input
											class="ms-qchip__input"
											type="radio"
											name="frequency"
											id={`ms-q-freq-${frequency.value}`}
											value={frequency.value}
											checked={index === 0}
										/>
										<label class="ms-qchip__label" for={`ms-q-freq-${frequency.value}`}>
											{t(`quote.${frequency.key}` as 'quote.fFreqOnce')}
										</label>
									</li>
								))
							}
						</ul>
					</div>

					<div class="ms-qrow">
						<label class="ms-qfield">
							<span class="ms-qfield__label">{t('quote.fStart')}</span>
							<input class="ms-qinput" type="date" name="startDate" />
						</label>
						<label class="ms-qfield">
							<span class="ms-qfield__label">
								{t('quote.fFlexible')}{' '}
								<span class="ms-qfield__optional">({t('quote.optional')})</span>
							</span>
							<input
								class="ms-qinput"
								type="text"
								name="flexibility"
								placeholder={t('quote.fFlexiblePlaceholder')}
							/>
						</label>
					</div>
				</fieldset>

				{/* ---- Step 4: contact ---- */}
				<fieldset class="ms-qstep" data-step="4">
					<legend class="ms-qstep__head" tabindex="-1">{t('quote.s4Title')}</legend>

					<div class="ms-qrow">
						<label class="ms-qfield">
							<span class="ms-qfield__label">{t('quote.fName')}</span>
							<input class="ms-qinput" type="text" name="name" autocomplete="name" required />
						</label>
						{/* Only asked of businesses, so it rides the same branch switch. */}
						<label class="ms-qfield" data-when="business">
							<span class="ms-qfield__label">{t('quote.fCompany')}</span>
							<input class="ms-qinput" type="text" name="company" autocomplete="organization" />
						</label>
					</div>

					<div class="ms-qrow">
						<label class="ms-qfield">
							<span class="ms-qfield__label">{t('quote.fEmail')}</span>
							<input class="ms-qinput" type="email" name="email" autocomplete="email" required />
						</label>
						<label class="ms-qfield">
							<span class="ms-qfield__label">
								{t('quote.fPhone')} <span class="ms-qfield__optional">({t('quote.optional')})</span>
							</span>
							<input class="ms-qinput" type="tel" name="phone" autocomplete="tel" />
						</label>
					</div>

					<div class="ms-qfield">
						<span class="ms-qfield__label">{t('quote.fPreferred')}</span>
						<ul class="ms-qchips">
							{
								[
									{ value: 'email', key: 'fPrefEmail' },
									{ value: 'phone', key: 'fPrefPhone' },
								].map((method, index) => (
									<li>
										<input
											class="ms-qchip__input"
											type="radio"
											name="preferredContact"
											id={`ms-q-pref-${method.value}`}
											value={method.value}
											checked={index === 0}
										/>
										<label class="ms-qchip__label" for={`ms-q-pref-${method.value}`}>
											{t(`quote.${method.key}` as 'quote.fPrefEmail')}
										</label>
									</li>
								))
							}
						</ul>
					</div>

					<label class="ms-qfield">
						<span class="ms-qfield__label">
							{t('quote.fMessage')} <span class="ms-qfield__optional">({t('quote.optional')})</span>
						</span>
						<textarea
							class="ms-qinput"
							name="message"
							rows="3"
							placeholder={t('quote.fMessagePlaceholder')}></textarea>
					</label>
				</fieldset>

				{/*
				 * Both controls start hidden and the script reveals them, so a page
				 * without JavaScript shows every step and one working submit rather
				 * than a Next button that goes nowhere. The script also moves this
				 * row into whichever step is on screen — the design puts the action
				 * inside the card, under a divider.
				 */}
				<div class="ms-quote__foot" hidden data-ms-quote-nav>
					<div class="ms-quote__nav">
						<button class="ms-quote__back" type="button" data-ms-quote-back>
							<Icon name="chevron-left" size={16} />
							{t('quote.back')}
						</button>
						<button class="ms-quote__next" type="button" data-ms-quote-next>
							{t('quote.next')}
							<Icon name="chevron-right" size={16} />
						</button>
						<button class="ms-quote__submit" type="submit" data-ms-quote-submit>
							<span data-ms-quote-submit-label>{t('quote.submit')}</span>
							<Icon name="send" size={16} />
						</button>
					</div>
					<p class="ms-quote__submit-note">{t('quote.submitNote')}</p>

					{/*
					 * The failure state. It lives in the action row so it travels with
					 * it into whichever step is on screen — which is always step four,
					 * because that is the only step with a submit. `role="alert"`:
					 * four steps of answers are sitting there unsent.
					 */}
					<div class="ms-quote__error" role="alert" hidden data-ms-quote-error>
						<b class="ms-quote__error-title">{t('quote.errorTitle')}</b>
						<span>{t('quote.errorBody')}</span>
						<span class="ms-quote__error-links">
							<a href={`tel:${SITE_DETAILS.phoneHref}`}>{SITE_DETAILS.phone}</a>
							<a href={`mailto:${SITE_DETAILS.email}`}>{SITE_DETAILS.email}</a>
						</span>
					</div>
				</div>
			</form>

			<div class="ms-quote__success" hidden data-ms-quote-success>
				<span class="ms-quote__success-icon">
					<Icon name="check" size={26} stroke={2.4} />
				</span>
				<h2 class="ms-quote__success-title" data-ms-quote-success-title>
					{t('quote.successTitle')}
				</h2>
				<p class="ms-quote__success-body" data-ms-quote-success-body>{t('quote.successBody')}</p>

				<p class="ms-qside__contact">
					<a class="ms-qside__link" href={`mailto:${SITE_DETAILS.email}`}>{SITE_DETAILS.email}</a>
					<a class="ms-qside__link" href={`tel:${SITE_DETAILS.phoneHref}`}>{SITE_DETAILS.phone}</a>
				</p>

				<button class="ms-qchip__label" type="button" data-ms-quote-again>
					{t('quote.successAgain')}
				</button>
			</div>
		</div>

		<aside class="ms-quote__side">
			<div class="ms-qside">
				<h2 class="ms-qside__title">{t('quote.sideTitle')}</h2>
				<ol class="ms-qside__list">
					<li class="ms-qside__item">{t('quote.sideOne')}</li>
					<li class="ms-qside__item">{t('quote.sideTwo')}</li>
					<li class="ms-qside__item">{t('quote.sideThree')}</li>
				</ol>

				<div class="ms-qside__contact">
					<p>{t('quote.sideContact')}</p>
					<a class="ms-qside__link" href={`tel:${SITE_DETAILS.phoneHref}`}>{SITE_DETAILS.phone}</a>
					<a class="ms-qside__link" href={`mailto:${SITE_DETAILS.email}`}>{SITE_DETAILS.email}</a>
				</div>
			</div>
		</aside>
	</div>
</Section>

<script
	is:inline
	define:vars={{
		countTemplate: t('quote.stepOf'),
		sendingLabel: t('quote.sending'),
		submitLabel: t('quote.submit'),
		pendingTitle: t('quote.pendingTitle'),
		pendingBody: t('quote.pendingBody'),
		pendingAgain: t('quote.pendingAgain'),
		kindLabel: t('quote.step1'),
	}}
>
	document.querySelectorAll('.ms-quote__form').forEach((form) => {
		const LAST = 4;

		const stepper = document.querySelector('[data-ms-stepper]');
		const count = document.querySelector('[data-ms-quote-count]');
		const nav = form.querySelector('[data-ms-quote-nav]');
		const back = form.querySelector('[data-ms-quote-back]');
		const next = form.querySelector('[data-ms-quote-next]');
		const submit = form.querySelector('[data-ms-quote-submit]');
		const note = form.querySelector('.ms-quote__submit-note');
		const success = document.querySelector('[data-ms-quote-success]');
		const panels = Array.from(form.querySelectorAll('[data-step]'));

		let current = 1;

		const branch = () => form.querySelector('[name="customerKind"]:checked').value;

		/* The panels that make up a step: the ones for this step number, minus
		   the branch that is not selected. */
		const panelsFor = (step) =>
			panels.filter(
				(panel) => Number(panel.dataset.step) === step && (!panel.dataset.when || panel.dataset.when === branch()),
			);

		/* Disabling the inactive branch keeps its fields out of submission and
		   out of validation; resetting them means a switch never leaves data
		   from the other half behind. `<fieldset disabled>` covers a whole step;
		   the company field is a lone label, so it is handled by name. */
		function syncBranch() {
			const active = branch();

			panels.forEach((panel) => {
				if (!panel.dataset.when) return;
				const on = panel.dataset.when === active;
				if (panel.disabled === on) resetFields(panel);
				panel.disabled = !on;
			});

			form.querySelectorAll('.ms-qfield[data-when]').forEach((field) => {
				const on = field.dataset.when === active;
				field.hidden = !on;
				field.querySelectorAll('input, select, textarea').forEach((input) => {
					if (input.disabled === on) resetField(input);
					input.disabled = !on;
				});
			});
		}

		function resetField(input) {
			if (input.type === 'radio' || input.type === 'checkbox') input.checked = input.defaultChecked;
			else if (input.tagName === 'SELECT') input.selectedIndex = 0;
			else input.value = input.defaultValue;
		}

		function resetFields(scope) {
			scope.querySelectorAll('input, select, textarea').forEach(resetField);
		}

		function render() {
			panels.forEach((panel) => {
				panel.hidden = !panelsFor(current).includes(panel);
			});

			/* `data-stepper-step`, not `data-step`: the form's own fieldsets use
			   that one, and a document-wide query for it would pick up both. */
			Array.from(stepper.children).forEach((item) => {
				const step = Number(item.dataset.stepperStep);
				item.classList.toggle('is-current', step === current);
				item.classList.toggle('is-done', step < current);
				if (step === current) item.setAttribute('aria-current', 'step');
				else item.removeAttribute('aria-current');
			});

			count.textContent = countTemplate.replace('{current}', current).replace('{total}', LAST);

			/* The action row lives inside the step it belongs to, which is what
			   the design draws. Moving one element keeps its listeners. */
			const card = panelsFor(current)[0];
			if (card && nav.parentElement !== card) card.appendChild(nav);

			back.hidden = current === 1;
			next.hidden = current === LAST;
			submit.hidden = current !== LAST;
			note.hidden = current !== LAST;
		}

		function focusStep() {
			const head = panelsFor(current)[0]?.querySelector('.ms-qstep__head');
			head?.focus();
		}

		/* Validates only what is on screen. `reportValidity()` on the form would
		   also flag a required field three steps ahead, which reads as the wizard
		   refusing to move for no visible reason. */
		function stepIsValid() {
			for (const panel of panelsFor(current)) {
				for (const input of panel.querySelectorAll('input, select, textarea')) {
					if (!input.checkValidity()) {
						input.reportValidity();
						return false;
					}
				}
			}
			return true;
		}

		next.addEventListener('click', () => {
			if (!stepIsValid()) return;
			current = Math.min(current + 1, LAST);
			render();
			focusStep();
		});

		back.addEventListener('click', () => {
			current = Math.max(current - 1, 1);
			render();
			focusStep();
		});

		form.querySelectorAll('[name="customerKind"]').forEach((input) => {
			input.addEventListener('change', () => {
				syncBranch();
				render();
			});
		});

		/* Enter inside a text field submits a form; on any step but the last that
		   should advance instead. */
		form.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' || current === LAST) return;
			if (event.target.tagName === 'TEXTAREA') return;
			event.preventDefault();
			next.click();
		});

		const error = form.querySelector('[data-ms-quote-error]');
		const submitLabelEl = form.querySelector('[data-ms-quote-submit-label]');

		/* ---- What the client actually receives -----------------------------
		 * Web3Forms builds its mail from the field names and values it is given,
		 * one labelled block per field, and there is no template to change on the
		 * free tier. Two things follow, and both are why this function exists.
		 *
		 * ONE: field names must be ASCII. Web3Forms decodes the names out of the
		 * multipart body as Latin-1, so a label sent as "Fläche in m²" arrived as
		 * "FlÃ¤che in mÂ²". Values are decoded correctly — the subject line has
		 * carried an umlaut since the first submission. So every group key below
		 * is plain ASCII and every word that needs an umlaut lives in a value.
		 *
		 * TWO: one block per field made the mail eighteen blocks long and put the
		 * reader three screens from the answer. The fields are therefore folded
		 * into four groups — who is asking, what they want, when, and anything
		 * they wrote — so the mail is six short blocks instead.
		 *
		 * The group keys are fixed German, because the client reads them and they
		 * should sort the same way whatever language the enquiry came in. What is
		 * inside a group is not: those labels and values are lifted out of the
		 * DOM, so a Slovak enquiry reads in Slovak, and the mail cannot drift
		 * from the form — change a caption and the email follows.
		 *
		 * `name` and `email` stay as they are. Web3Forms reads `email` to set
		 * Reply-To, and both render as their own block at the top, which is where
		 * a reader wants them.
		 */
		const RESERVED = ['access_key', 'subject', 'from_name', 'botcheck'];
		const KEEP_MACHINE_NAME = ['name', 'email'];

		const GROUPS = [
			{
				key: 'Kontakt',
				fields: ['phone', 'company', 'preferredContact'],
			},
			{
				key: 'Auftrag',
				fields: [
					'customerKind',
					/* private */
					'privateSize',
					'privateRooms',
					'privateBedrooms',
					'privateBaths',
					'cleaningType',
					'pets',
					'access',
					/* business */
					'premisesType',
					'businessSize',
					'businessFloors',
					'perWeek',
					'preferredHours',
					'specialRequirements',
				],
			},
			{
				key: 'Termin',
				fields: ['frequency', 'startDate', 'flexibility'],
			},
			/* The one the visitor wrote themselves, so it keeps the whole block and
			   is not prefixed with its own caption. */
			{ key: 'Nachricht', fields: ['message'], bare: true },
		];

		const tidy = (text) => text.replace(/\s+/g, ' ').trim();

		/* The caption above the control, minus the "(optional)" marker. */
		function fieldLabel(key) {
			if (key === 'customerKind') return kindLabel;
			const label = form
				.querySelector('[name="' + key + '"]')
				?.closest('.ms-qfield')
				?.querySelector('.ms-qfield__label');
			if (!label) return null;
			const clone = label.cloneNode(true);
			clone.querySelector('.ms-qfield__optional')?.remove();
			return tidy(clone.textContent);
		}

		/* The words on screen rather than the value attribute — "Ordination /
		   Praxis" rather than "clinic", "Wöchentlich" rather than "weekly". */
		function fieldValue(key, raw) {
			const control = form.querySelector('[name="' + key + '"]');
			if (!control) return raw;

			if (control.type === 'radio') {
				const checked = form.querySelector('[name="' + key + '"]:checked');
				if (!checked) return raw;
				const label = form.querySelector('label[for="' + checked.id + '"]');
				/* The customer-kind cards carry an icon and a note as well as the
				   name, so take the name alone. */
				const name = label?.querySelector('.ms-qopt__name');
				return tidy((name || label)?.textContent || raw);
			}

			if (control.tagName === 'SELECT') {
				return tidy(control.selectedOptions[0]?.textContent || raw);
			}

			return raw;
		}

		function buildPayload() {
			/* Branch-aware for free: the inactive half of the form is a disabled
			   fieldset, so its fields are already absent here. */
			const source = new FormData(form);
			const out = new FormData();

			for (const key of RESERVED) if (source.has(key)) out.append(key, source.get(key));
			for (const key of KEEP_MACHINE_NAME) {
				const value = String(source.get(key) ?? '').trim();
				if (value) out.append(key, value);
			}

			const used = new Set([...RESERVED, ...KEEP_MACHINE_NAME]);

			for (const group of GROUPS) {
				const parts = [];
				for (const key of group.fields) {
					if (!source.has(key)) continue;
					used.add(key);
					const raw = String(source.get(key)).trim();
					/* An optional field nobody filled in is noise, not information. */
					if (!raw) continue;
					const value = fieldValue(key, raw);
					parts.push(group.bare ? value : (fieldLabel(key) || key) + ': ' + value);
				}
				if (parts.length) out.append(group.key, parts.join('  ·  '));
			}

			/* A field this list has never heard of still goes, rather than being
			   silently dropped the day someone adds one to the form. */
			const rest = [];
			for (const key of source.keys()) {
				if (used.has(key)) continue;
				used.add(key);
				const raw = String(source.get(key)).trim();
				if (raw) rest.push((fieldLabel(key) || key) + ': ' + fieldValue(key, raw));
			}
			if (rest.length) out.append('Weitere Angaben', rest.join('  ·  '));

			return out;
		}

		function showSuccess() {
			form.hidden = true;
			success.hidden = false;
			success.setAttribute('tabindex', '-1');
			success.focus();
			success.scrollIntoView({ block: 'center' });
		}

		if (success) {
			/* No key yet: nothing is transmitted, and the panel says so instead of
			   claiming a delivery that did not happen. Same panel, different words
			   — see quote.pendingTitle / pendingBody in the dictionaries. */
			if (form.dataset.msQuote === 'pending') {
				success.querySelector('[data-ms-quote-success-title]').textContent = pendingTitle;
				success.querySelector('[data-ms-quote-success-body]').textContent = pendingBody;
				success.querySelector('[data-ms-quote-again]').textContent = pendingAgain;

				form.addEventListener('submit', (event) => {
					event.preventDefault();
					showSuccess();
				});
			} else {
				form.addEventListener('submit', async (event) => {
					event.preventDefault();
					error.hidden = true;
					submit.disabled = true;
					submitLabelEl.textContent = sendingLabel;

					try {
						const response = await fetch(form.action, {
							method: 'POST',
							body: buildPayload(),
							headers: { Accept: 'application/json' },
						});
						const result = await response.json().catch(() => ({}));
						if (!response.ok || result.success !== true) throw new Error('rejected');

						showSuccess();
					} catch {
						/* All four steps keep their values. */
						error.hidden = false;
						error.scrollIntoView({ block: 'center' });
					} finally {
						submit.disabled = false;
						submitLabelEl.textContent = submitLabel;
					}
				});
			}

			success.querySelector('[data-ms-quote-again]')?.addEventListener('click', () => {
				/* A real send resets the form; the pending path does not, because
				   "Angaben ändern" promises the answers are still there. */
				if (form.dataset.msQuote === 'live') {
					form.reset();
					syncBranch();
				}
				success.hidden = true;
				form.hidden = false;
				current = 1;
				render();
				form.scrollIntoView({ block: 'start' });
			});
		}

		nav.hidden = false;
		syncBranch();
		render();
	});
</script>
